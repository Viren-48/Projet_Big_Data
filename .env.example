# Copier en .env (fait automatiquement par `make up`) et adapter. Ne jamais committer .env.

# --- HDFS / Kafka / chemins ---
HDFS_URI=hdfs://namenode:8020
HDFS_REPLICATION=2
KAFKA_BOOTSTRAP=kafka:9092
STATSBOMB_DIR=/data/statsbomb/data
SERVING_DIR=/serving
TOPIC_EVENTS=match-events
TOPIC_SHOTS=xg-shots
TOPIC_TOTALS=xg-team-totals

# --- Cluster Spark (ressources : à baisser si Docker a moins de 10 Go de RAM) ---
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_HOST=spark
WORKER_CORES=2
WORKER_MEMORY=2g
EXECUTOR_CORES=2
EXECUTOR_MEMORY=1g
TOTAL_CORES=4
DRIVER_MEMORY=2g

# --- PostgreSQL (base de restitution) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=xg
POSTGRES_USER=xg
POSTGRES_PASSWORD=change_me
